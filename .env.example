# ── Frontend (Vite) — valores públicos, embutidos no navegador ──────────────
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=chave-anon-publica

# ── Vercel Function /api/ai (somente servidor; nunca use prefixo VITE_) ──────
# Se ausente, a função usa VITE_OPENAI_API_KEY por compatibilidade (o valor não vai ao navegador).
OPENAI_API_KEY=sk-...
AI_LIMITE_DIARIO=80

# ── Supabase Edge Function r2-api (configurar como secrets no Supabase) ──────
# supabase secrets set MP_ACCESS_TOKEN=... MP_WEBHOOK_SECRET=... SITE_URL=...
MP_ACCESS_TOKEN=TEST-... (teste) ou APP_USR-... (produção)
MP_WEBHOOK_SECRET=assinatura-secreta-do-painel-mercado-pago
SITE_URL=https://r2-fit-pro.vercel.app
ALLOWED_ORIGINS=https://r2-fit-pro.vercel.app
RESEND_API_KEY=re_...
EMAIL_FROM=R2 Fit Pro <nao-responda@seudominio.com.br>
MP_WEBHOOK_TOLERANCIA_SEG=0
